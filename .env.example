# ==============================================================================
#  Claro Conversation Hub — variáveis de ambiente
#  Copie para `.env` na raiz do projeto:  cp .env.example .env
# ==============================================================================

ENVIRONMENT=development
# URL pública da API
PUBLIC_URL=http://localhost:8000


# ------------------------------------------------------------------------------
#  MOTOR DE INTENÇÃO E REDAÇÃO DAS RESPOSTAS
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT=12
LLM_MAX_TOKENS=400

# ------------------------------------------------------------------------------
#  PARÂMETROS EXTRAS DO PROVEDOR  (JSON, opcional)
LLM_EXTRA_PARAMS={"include_reasoning": false, "reasoning_effort": "low"}


# ------------------------------------------------------------------------------
#  CANAL WHATSAPP — WhatsApp Business Cloud API (Meta)
# ------------------------------------------------------------------------------
#  Canal principal do MVP. Enquanto WHATSAPP_ENABLED=false o hub opera só com o
#  simulador embutido — o que é o normal em desenvolvimento, já que o webhook
#  exige URL pública.
#
#  Como obter cada valor:
#
#  1. Acesse developers.facebook.com e crie um app do tipo "Business".
#  2. Adicione o produto "WhatsApp". O painel já entrega um número de teste.
#  3. WHATSAPP_PHONE_NUMBER_ID  — painel do WhatsApp > "Configuração da API"
#                                 (é o ID do número, não o telefone em si)
#  4. WHATSAPP_BUSINESS_ACCOUNT_ID — mesma tela, campo "ID da conta comercial"
#  5. WHATSAPP_ACCESS_TOKEN     — token temporário (24h) na mesma tela, ou um
#                                 token permanente via usuário do sistema no
#                                 Business Manager. Para a demonstração, o
#                                 temporário basta; gere um novo no dia.
#  6. WHATSAPP_VERIFY_TOKEN     — string inventada por você. A Meta devolve ela
#                                 na verificação do webhook e o hub confere.
#                                 Ex.: claro-hub-labware-2026
#  7. WHATSAPP_APP_SECRET       — "Configurações do app > Básico > Chave secreta".
#                                 Usado para validar a assinatura de cada webhook.
#                                 Opcional, mas sem ele qualquer um pode postar
#                                 mensagens falsas no seu endpoint.
#  8. WHATSAPP_DEFAULT_RECIPIENT — número no formato internacional, só dígitos
#                                 (ex.: 5511987654321). Precisa estar cadastrado
#                                 como destinatário de teste no painel da Meta.
#
#  Configurando o webhook na Meta:
#    URL de callback:  <PUBLIC_URL>/api/v1/channels/whatsapp/webhook
#    Token de verificação: o mesmo WHATSAPP_VERIFY_TOKEN abaixo
#    Campos a assinar: messages
#
#  Em desenvolvimento, exponha a API local com um túnel:
#    ngrok http 8000          (ou: cloudflared tunnel --url http://localhost:8000)
#  e coloque a URL gerada em PUBLIC_URL acima.
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_TIMEOUT=10


# ------------------------------------------------------------------------------
#  PERSISTÊNCIA
# ------------------------------------------------------------------------------
#  Sem estas, o hub sobe em memória e avisa o modo no /health.
REDIS_URL=redis://redis:6379/0
MONGO_URL=mongodb://mongo:27017
MONGO_DB=claro_hub

SESSION_TTL_SECONDS=1800
HANDOVER_CONFIDENCE_THRESHOLD=0.55


# ------------------------------------------------------------------------------
#  FRONT-END
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
